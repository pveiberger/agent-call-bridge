# For localhost testing. On phones, use an HTTPS reverse proxy and its exact origin.
PUBLIC_ORIGIN=http://localhost:8091
AGENT_BACKEND=nod
WEB_AUTH=token
# Generate a private value with: openssl rand -hex 32
BRIDGE_WEB_TOKEN=
# Supply this only when enabling a native messaging channel.
BRIDGE_CHANNEL_SECRET=

# Nod server as seen from the bridge container; NOD_PUBLIC_URL is Nod's own origin.
NOD_BASE_URL=http://nod-server:4310
NOD_PUBLIC_URL=https://nod.example.org
NOD_AUTH_TOKEN=
NOD_PORT=4310

# Hermes or OpenClaw: private base URL including /v1 and its agent access key.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
CHAT_URL=
# Compatible transcription endpoint including /v1. Optional for Nod.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# German vocabulary, names and terms expected in calls.
STT_PROMPT=
# Set true for the optional whisper.cpp short-utterance profile.
STT_WHISPER_SHORT_CONTEXT=false
# Optional local Parakeet first pass with a second recognizer for uncertain speech.
STT_FAST_BASE_URL=
CALL_PREPARE_SHORT_SPEECH=false
STT_HOTWORDS=
