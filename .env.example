# For localhost testing. On phones, use an HTTPS reverse proxy and its exact origin.
PUBLIC_ORIGIN=http://localhost:8091
AGENT_BACKEND=nod
WEB_AUTH=token
# Generate a private value with: openssl rand -hex 32
BRIDGE_WEB_TOKEN=
# Supply this only when enabling a native messaging channel.
BRIDGE_CHANNEL_SECRET=

# Nod server as seen from the bridge container; NOD_PUBLIC_URL is Nod's own origin.
NOD_BASE_URL=http://nod-server:4310
NOD_PUBLIC_URL=https://nod.example.org
NOD_AUTH_TOKEN=
NOD_PORT=4310

# Hermes or OpenClaw: private base URL including /v1 and its agent access key.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
CHAT_URL=
# OpenAI-compatible transcription endpoint including /v1 (Hermes and OpenClaw).
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
