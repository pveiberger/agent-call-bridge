# Credentials for the receiver's own Telegram application from my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Positive numeric Telegram user ID of the human allowed to call the assistant.
# Additional comma-separated IDs also gain audio access to this assistant.
TELEGRAM_ALLOWED_CALLERS=
BRIDGE_BASE_URL=http://bridge:8091
# Match BRIDGE_CHANNEL_SECRET in the bridge's .env.
BRIDGE_CHANNEL_SECRET=
